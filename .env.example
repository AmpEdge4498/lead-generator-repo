# Lead Generator — Environment Configuration
# Copy this file to .env and fill in your API keys

# Server
PORT=3000

# Google Maps/Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Bing Maps API (optional)
BING_MAPS_API_KEY=your_bing_maps_api_key_here

# Default Search Location (Kolkata/Howrah/West Bengal)
DEFAULT_LAT=22.5726
DEFAULT_LNG=88.3639
DEFAULT_RADIUS=50000
DEFAULT_REGION=West Bengal
